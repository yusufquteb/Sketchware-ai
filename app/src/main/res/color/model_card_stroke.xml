<?xml version="1.0" encoding="utf-8"?>
<!-- Stroke for item_model.xml's card: visible primary-colored box around the currently
     active model, transparent otherwise. Paired with android:checkable="true" there —
     without checkable, MaterialCardView silently ignores setChecked() and the active
     model had no visual marker at all (audit fix, user-reported). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="?attr/colorPrimary" />
    <item android:color="@android:color/transparent" />
</selector>
