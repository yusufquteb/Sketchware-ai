<?xml version="1.0" encoding="utf-8"?>
<!--
    item_chat_message_assistant.xml
    Binding: ItemChatMessageAssistantBinding
    IDs used by ChatAdapter.AssistantViewHolder:
      message_meta, streaming_badge,
      reasoning_card, reasoning_summary, reasoning_detail,
      message_content,
      tools_container,
      message_actions_row, btn_copy_message, btn_share_message, btn_expand_message

    NOTE: btn_expand_message is now an ImageButton in the actions row (not inside the bubble).
          The floating expand overlay INSIDE the bubble has been removed per design spec.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingStart="12dp"
    android:paddingEnd="48dp">

    <!-- ── Row 1: AI avatar circle + timestamp + live badge ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <!--
            AI icon: 28dp circle with primary-container bg
            Icon: ic_ai_robot (Gemini/robot icon from project)
            Tint: colorOnPrimaryContainer (white in light, white in dark)
        -->
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_ai_icon_circle"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:contentDescription=""
            app:srcCompat="@drawable/ic_ai_robot"
            app:tint="?attr/colorOnPrimaryContainer" />

        <!-- Timestamp: 11sp, low opacity -->
        <TextView
            android:id="@+id/message_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:alpha="0.65"
            android:textColor="?attr/colorOnSurface" />

        <!-- "live" streaming badge -->
        <TextView
            android:id="@+id/streaming_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_model_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="live"
            android:textSize="10sp"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ── Row 2: Reasoning / thinking card (hidden by default) ── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/reasoning_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/reasoning_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thinking..."
                android:textSize="13sp"
                android:textStyle="italic"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/reasoning_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ── Row 3: Message bubble ── -->
    <!--
        Clean bubble - NO floating expand button inside.
        bg_assistant_bubble: surfaceVariant color, asymmetric corners
        (top-left=4dp tail, rest=20dp) matching screenshot.
        Elevation 1dp subtle shadow.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_assistant_bubble"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!--
            A) TEXT — Markwon markdown rendered here.
            visibility: VISIBLE for text msgs, GONE for tool-calls-only.
            Max 8 lines collapsed; expand via actions row.
        -->
        <TextView
            android:id="@+id/message_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.45"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ── Row 4: Tool call cards (injected programmatically by adapter) ── -->
    <LinearLayout
        android:id="@+id/tools_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

    <!-- ── Row 5: Action buttons ── -->
    <!--
        From image (RTL): توسيع | مشاركة | نسخ  (Expand | Share | Copy)
        In LTR: Copy | Share | Expand
        Each button = flat icon + label below, no circle background.
        Icon size = 22dp, touch target = 40dp x 40dp minimum.
        Label: 11sp, colorOnSurfaceVariant.
        Spacing between groups: 16dp margin.
    -->
    <LinearLayout
        android:id="@+id/message_actions_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:paddingStart="2dp"
        android:visibility="gone">

        <!-- Copy: icon + label stacked -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="false"
            android:focusable="false">

            <ImageButton
                android:id="@+id/btn_copy_message"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_action_copy"
                android:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="Copy"
                android:padding="9dp"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Copy"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Share: icon + label -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="false"
            android:focusable="false">

            <ImageButton
                android:id="@+id/btn_share_message"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_action_share"
                android:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="Share"
                android:padding="9dp"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Expand / Collapse: icon + label — FULLY FUNCTIONAL via adapter -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="false"
            android:focusable="false">

            <ImageButton
                android:id="@+id/btn_expand_message"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_action_expand"
                android:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="Expand"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/label_expand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expand"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
