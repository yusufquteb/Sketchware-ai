<?xml version="1.0" encoding="utf-8"?>
<!--
  Bottom Sheet layout for the AI → UI Generator dialog.
  Shown inside AiUiGeneratorDialog (BottomSheetDialogFragment).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:clipToPadding="false">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_sheet_handle"
        android:backgroundTint="?attr/colorOutline" />

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_agent"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/ai_ui_gen_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- Prompt input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_ai_prompt"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/ai_ui_gen_prompt_hint"
        app:counterEnabled="true"
        app:counterMaxLength="500">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_ai_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:maxLines="6"
            android:maxLength="500"
            android:inputType="textMultiLine|textCapSentences"
            android:gravity="top"
            android:imeOptions="flagNoEnterAction" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Generate button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_ai_generate"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ai_ui_gen_btn_generate"
        android:enabled="false"
        app:icon="@drawable/ic_agent" />

    <!-- Progress + Status row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:minHeight="32dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_ai_gen"
            style="@style/Widget.Material3.CircularProgressIndicator.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_ai_gen_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:text="" />
    </LinearLayout>

    <!-- Preview section (hidden until generation succeeds) -->
    <LinearLayout
        android:id="@+id/layout_ai_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp">

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginBottom="12dp" />

        <!-- Preview title: "Generated: N components" -->
        <TextView
            android:id="@+id/tv_preview_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary" />

        <!-- Component chips list -->
        <LinearLayout
            android:id="@+id/layout_component_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp" />

    </LinearLayout>

    <!-- Action buttons: Apply + Regenerate (hidden until preview is ready) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ai_regenerate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/ai_ui_gen_btn_regenerate"
            android:visibility="gone"
            app:icon="@drawable/ic_refresh" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ai_apply"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ai_ui_gen_btn_apply"
            android:visibility="gone"
            app:icon="@drawable/ic_check" />
    </LinearLayout>

    <!-- Bottom padding for navigation bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" />

</LinearLayout>
