<?xml version="1.0" encoding="utf-8"?>
<!--
    item_chat_msg_system.xml
    =========================
    System notification banner — centered, no interaction.
    Used by ChatMessageAdapter.SystemViewHolder.

    IDs: chat_msg_text

    Examples: "Conversation cleared." / "File attached." / "Tool executed."
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/chat_msg_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/chat_system_msg_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:gravity="center" />

</FrameLayout>
