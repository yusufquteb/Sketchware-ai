<?xml version="1.0" encoding="utf-8"?>
<!--
    item_chat_message_user.xml
    Binding: ItemChatMessageUserBinding
    IDs: message_meta, message_content, btn_copy_message

    Screenshot analysis:
    - Time "08:53 صباحاً" at top-right, small, low opacity
    - Purple bubble right-aligned, 20dp corners, white text
    - Small copy icon below bubble on right (no label)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingStart="64dp"
    android:paddingEnd="12dp">

    <!-- Timestamp — top-right, 11sp, alpha 0.6 -->
    <TextView
        android:id="@+id/message_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginBottom="4dp"
        android:textSize="11sp"
        android:alpha="0.6"
        android:textColor="?attr/colorOnSurface" />

    <!--
        User bubble — gravity=end, colorPrimary bg, 20dp corners.
        Text: colorOnPrimary (white in both light/dark).
        max width enforced by parent paddingStart="64dp"
    -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_user_message"
        android:elevation="1dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/message_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.4"
            android:textSize="14sp"
            android:textColor="?attr/colorOnPrimary"
            android:textIsSelectable="true"
    android:longClickable="true"/>

    </LinearLayout>

    <!-- Copy action — right-aligned, minimal, no label for user messages -->
    <ImageButton
        android:id="@+id/btn_copy_message"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="end"
        android:layout_marginTop="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_action_copy"
        android:tint="?attr/colorOnSurfaceVariant"
        android:contentDescription="Copy"
        android:padding="7dp"
        android:alpha="0.65"
        android:scaleType="fitCenter" />

</LinearLayout>
