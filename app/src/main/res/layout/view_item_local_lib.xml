<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="2dp"
        android:checkable="true"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="24dp"
        app:checkedIcon="@null">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="4dp"
            android:paddingStart="20dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/library_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintEnd_toStartOf="@id/btn_refresh_lib"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/library_size"
                app:layout_constraintTop_toTopOf="@id/material_switch"
                tools:text="appcompat-v1.7.0" />

            <TextView
                android:id="@+id/library_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintBottom_toTopOf="@id/version_row"
                app:layout_constraintEnd_toStartOf="@id/btn_refresh_lib"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/library_name"
                tools:text="3.4 KB" />

            <!-- Version row: current version | latest arrow | update button -->
            <LinearLayout
                android:id="@+id/version_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="@id/material_switch"
                app:layout_constraintEnd_toStartOf="@id/btn_refresh_lib"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/library_size">

                <TextView
                    android:id="@+id/tv_current_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="v4.9.1" />

                <TextView
                    android:id="@+id/tv_latest_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="#4CAF50"
                    android:visibility="gone"
                    tools:text="→ v4.12.0" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/btn_update_lib"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Update"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:clickable="true"
                    android:focusable="true"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#2E7D32"
                    app:chipStrokeWidth="1.5dp"
                    android:textColor="#2E7D32"
                    app:chipMinHeight="26dp"
                    app:ensureMinTouchTargetSize="false"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Per-library refresh icon: always visible -->
            <ImageButton
                android:id="@+id/btn_refresh_lib"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Refresh version"
                android:src="@drawable/ic_refresh"
                android:tint="?attr/colorOnSurfaceVariant"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/material_switch"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/material_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
