<?xml version="1.0" encoding="utf-8"?>
<!--
  Library AI Assistant Bottom Sheet
  MATCHES design_ai_bottom_sheet.xml structure exactly — v1
  Differences: header context, sidebar tools, empty-state chips, input hint.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lib_ai_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurfaceContainerLowest">

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!--  TOP HEADER ROW  (mirrors design sheet header exactly)       -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/lib_ai_handle_row"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:elevation="2dp">

        <!-- LEFT: "Library Manager" title + scope chip -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">

            <TextView
                android:id="@+id/lib_ai_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Local Library"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="?attr/colorOnSurface" />

            <!-- Scope chip: "All Libraries" or "Project: {name}" -->
            <LinearLayout
                android:id="@+id/lib_ai_scope_selector"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_model_chip"
                android:paddingStart="8dp"
                android:paddingEnd="6dp"
                android:layout_marginTop="2dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="4dp"
                    app:srcCompat="@drawable/ic_mtrl_box"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/lib_ai_scope_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All Libraries"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorPrimary"
                    android:maxWidth="120dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="2dp"
                    app:srcCompat="@drawable/ic_ai_robot"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>
        </LinearLayout>

        <!-- CENTRE: Provider name + model chip (same as design sheet) -->
        <LinearLayout
            android:id="@+id/lib_ai_model_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_model_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/lib_ai_provider_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Provider"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:maxLines="1"
                android:ellipsize="end"
                android:maxWidth="110dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/lib_ai_model_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Model"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="100dp" />

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="2dp"
                    app:srcCompat="@drawable/ic_mtrl_arrow_down"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <!-- RIGHT: Settings, Clear, Close -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/lib_ai_btn_settings"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="AI Settings"
            app:icon="@drawable/ic_mtrl_settings"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lib_ai_btn_clear"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="Clear chat"
            app:icon="@drawable/ic_mtrl_delete"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lib_ai_btn_close"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="Close"
            app:icon="@drawable/ic_mtrl_close"
            app:iconSize="20dp" />

    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dividerColor="?attr/colorSurfaceContainerHighest" />

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!--  BODY: Sidebar (left) + Chat (right)                         -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- LEFT SIDEBAR — collapsible (48dp icon-only ↔ 220dp expanded) -->
        <LinearLayout
            android:id="@+id/lib_ai_sidebar_container"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:elevation="1dp"
            android:clipChildren="true"
            android:clipToPadding="true">

            <!-- Expand / collapse toggle -->
            <LinearLayout
                android:id="@+id/lib_ai_sidebar_toggle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/lib_ai_sidebar_toggle_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/ic_mtrl_sidebar"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- Library tools RecyclerView — same structure as design sidebar -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lib_ai_tools_rv"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="ifContentScrolls"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

        </LinearLayout>

        <!-- Sidebar / Chat divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="?attr/colorOutlineVariant" />

        <!-- RIGHT CHAT AREA -->
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false">

            <!-- Messages list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lib_ai_messages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls"
                android:paddingHorizontal="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:stackFromEnd="true" />

            <!-- Scroll-to-bottom FAB -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/lib_ai_fab_scroll_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="8dp"
                android:stateListAnimator="@null"
                android:elevation="4dp"
                android:contentDescription="Scroll to bottom"
                android:visibility="gone"
                app:backgroundTint="?attr/colorPrimaryContainer"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_mtrl_arrow_down"
                app:tint="?attr/colorOnPrimaryContainer" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/lib_ai_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:visibility="visible">

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp">

                    <View
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/bg_empty_state_circle" />

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:contentDescription="Library AI"
                        app:srcCompat="@drawable/ic_ai_robot" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Library Assistant"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Ask me to find updates, detect conflicts,\nsearch Maven, or explain any library."
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- Quick-start chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="24dp"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/lib_ai_chip_updates"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Find updates"
                            android:layout_marginEnd="8dp"
                            style="@style/Widget.Material3.Chip.Suggestion" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/lib_ai_chip_conflicts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Detect conflicts"
                            style="@style/Widget.Material3.Chip.Suggestion" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/lib_ai_chip_search"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Search Maven"
                            android:layout_marginEnd="8dp"
                            style="@style/Widget.Material3.Chip.Suggestion" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/lib_ai_chip_explain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Explain library"
                            style="@style/Widget.Material3.Chip.Suggestion" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </RelativeLayout>
    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!--  BOTTOM INPUT AREA  (identical to design sheet)              -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLowest"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:elevation="4dp">

        <!-- Typing indicator -->
        <LinearLayout
            android:id="@+id/lib_ai_typing_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:indeterminate="true"
                app:indicatorSize="14dp"
                app:trackThickness="2dp" />

            <TextView
                android:id="@+id/lib_ai_typing_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Thinking..."
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Input pill — no attach button, clean like Design sheet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_input_pill"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingVertical="6dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/lib_ai_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@android:color/transparent"
                android:hint="Ask anything about your libraries..."
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:minHeight="40dp"
                android:paddingHorizontal="0dp"
                android:paddingVertical="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lib_ai_btn_mic"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="Voice input"
                app:icon="@drawable/ic_chat_mic"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lib_ai_btn_send"
                style="@style/Widget.Material3.Button.Icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:contentDescription="Send"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_chat_send"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="?attr/colorOnPrimary" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
