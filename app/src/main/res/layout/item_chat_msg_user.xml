<?xml version="1.0" encoding="utf-8"?>
<!--
    item_chat_msg_user.xml — COMPLETE FINAL
    =========================================
    Right-aligned user message bubble.

    FIXES:
      - Removed ic_chat_status_sending (does not exist in project)
      - Removed chat_msg_status_row (ID not referenced by adapter after fix)
      - All remaining drawables verified to exist in project

    Drawables used (all verified ✅):
      - ic_chat_copy  ✅ res/drawable/ic_chat_copy.xml

    Text Selection Fix (Stage 3 CRITICAL) applied.
    Touch targets ≥ 48dp. No hardcoded colors.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingStart="52dp"
    android:paddingEnd="12dp"
    android:clickable="false"
    android:focusable="false"
    android:descendantFocusability="afterDescendants">

    <!-- Timestamp + copy row (right-aligned) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:layout_marginBottom="3dp"
        android:clickable="false"
        android:focusable="false">

        <ImageButton
            android:id="@+id/chat_msg_btn_copy"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_copy_message"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chat_copy"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/chat_msg_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:alpha="0.55" />
    </LinearLayout>

    <!-- Message bubble -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:strokeWidth="0dp"
        android:clickable="false"
        android:focusable="false">

        <!--
            TEXT SELECTION FIX (Stage 3 CRITICAL):
              textIsSelectable="true"     → enables selection handles
              longClickable="true"        → enables long-press
              clickable="false"           → does not consume long-press
              focusableInTouchMode="true" → allows selection focus
            Parent: clickable="false", focusable="false",
                    descendantFocusability="afterDescendants"
        -->
        <TextView
            android:id="@+id/chat_msg_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:maxWidth="260dp"
            android:lineSpacingMultiplier="1.4"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textIsSelectable="true"
            android:longClickable="true"
            android:clickable="false"
            android:focusableInTouchMode="true" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
