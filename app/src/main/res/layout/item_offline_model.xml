<?xml version="1.0" encoding="utf-8"?>
<!--
    Redesigned to match item_ai_provider.xml's card language (icon, name row with
    badge, status line, expandable body) so the Offline Models list and the AI
    Providers list below it feel like one consistent design instead of two
    different UI styles on the same screen.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Header row: icon + name/status ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:id="@+id/layout_model_header_row">

            <!-- Model icon: on-device chip icon, tinted green when this is the active model -->
            <ImageView
                android:id="@+id/iv_model_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mtrl_downloading"
                app:tint="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_model_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Gemma 3 1B ★" />

                    <!-- ACTIVE / GATED badge -->
                    <TextView
                        android:id="@+id/tv_model_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"
                        android:background="@drawable/bg_ai_get_key_button"
                        android:visibility="gone"
                        tools:text="🔒 GATED"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- Tier · size · RAM -->
                <TextView
                    android:id="@+id/tv_model_tier"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="2dp"
                    tools:text="Low-end device · 1.0 GB · needs about 4 GB RAM" />

                <!-- Download state (Not downloaded / Downloading NN% / Ready / Active) -->
                <TextView
                    android:id="@+id/tv_model_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textSize="11sp"
                    tools:text="Not downloaded" />
            </LinearLayout>

            <!-- Expand/collapse arrow for this model's details -->
            <ImageView
                android:id="@+id/iv_model_expand_arrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_mtrl_arrow_down"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- ── Expandable body: capability note, progress, error, actions ── -->
        <LinearLayout
            android:id="@+id/layout_model_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_model_capability_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                tools:text="Best balance of quality and size for mid-range devices." />

            <LinearLayout
                android:id="@+id/layout_model_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btn_model_pause_resume"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Pause download"
                    tools:src="@drawable/ic_mtrl_pause" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_model_download"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:indeterminate="false"
                    app:trackThickness="4dp" />

                <TextView
                    android:id="@+id/tv_model_progress_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    tools:text="42%" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_model_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                tools:text="Download failed: connection lost" />

            <!-- Direct link to this model's Hugging Face page — only shown for gated models.
                 One tap opens the exact page to log in and click "Agree" on the license,
                 instead of the user having to search huggingface.co and possibly not find it. -->
            <LinearLayout
                android:id="@+id/btn_model_hf_page"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_ai_get_key_button"
                android:paddingHorizontal="12dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_mtrl_key"
                    android:scaleType="fitCenter"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Accept license on Hugging Face"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="?attr/textAppearanceLabelSmall" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_mtrl_arrow_right"
                    android:scaleType="fitCenter"
                    app:tint="?attr/colorPrimary" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_model_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                tools:text="Download" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
