<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Header row: icon + name/status + switch ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Provider icon -->
            <ImageView
                android:id="@+id/provider_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter" />

            <!-- Name + status + models count -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/provider_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <!-- FREE / ∞ badge -->
                    <TextView
                        android:id="@+id/provider_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"
                        android:background="@drawable/bg_ai_get_key_button"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Enabled / Disabled status -->
                <TextView
                    android:id="@+id/provider_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textSize="11sp" />

                <!-- Models count -->
                <TextView
                    android:id="@+id/provider_models_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Enable switch -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/provider_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- ── Expandable section: API Key + Get Key button ── -->
        <LinearLayout
            android:id="@+id/layout_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <!-- API key label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API Key"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:layout_marginBottom="4dp" />

            <!-- Key input row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_ai_api_key_field"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/input_api_key"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:inputType="textPassword"
                    android:hint="Enter API key"
                    android:textSize="13sp"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <ImageView
                    android:id="@+id/btn_show_key"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_mtrl_preview"
                    android:scaleType="fitCenter"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:padding="2dp"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <ImageView
                    android:id="@+id/btn_copy_key"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_mtrl_content_copy"
                    android:scaleType="fitCenter"
                    android:padding="2dp"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <!-- Get Key button -->
            <LinearLayout
                android:id="@+id/btn_get_key"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_ai_get_key_button"
                android:paddingHorizontal="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/get_key_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_mtrl_key"
                    android:scaleType="fitCenter"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/get_key_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="?attr/textAppearanceLabelSmall" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Get Key"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_mtrl_arrow_right"
                    android:scaleType="fitCenter"
                    android:layout_marginStart="4dp"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <!-- Refresh models button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="Refresh Models"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TextButton"
                app:icon="@drawable/ic_mtrl_refresh"
                app:iconSize="14dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
