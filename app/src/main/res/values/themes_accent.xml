<?xml version="1.0" encoding="utf-8"?>
<!--
    res/values/themes_accent.xml  ──  LIGHT variants
    ══════════════════════════════════════════════════════════════════
    4 Material 3 ThemeOverlay styles — light mode.
    Android picks this file automatically in day / light mode.
    Mirror names exist in res/values-night/themes_accent.xml (dark variants).

    Pack 1: Modern Blue Light  / Deep Blue IDE Dark   (default)
    Pack 2: Indigo Creator     / Indigo Night
    Pack 3: Emerald Studio     / Emerald Matrix
    Pack 4: Warm Orange        / Slate Professional
    ══════════════════════════════════════════════════════════════════
-->
<resources>

    <!-- ════════════════════════════════════════════════════════
         1.  Modern Blue  — professional, developer-focused
             Seed: #2563EB — Sketchware Pro brand identity.
             Default production theme for all new users.
         ════════════════════════════════════════════════════════ -->
    <style name="ThemeOverlay.Accent.ModernBlue" parent="">
        <!-- Primary -->
        <item name="colorPrimary">#2563EB</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#DBEAFE</item>
        <item name="colorOnPrimaryContainer">#1E3A8A</item>
        <item name="colorPrimaryInverse">#93C5FD</item>
        <!-- Secondary -->
        <item name="colorSecondary">#3B72D8</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#EFF6FF</item>
        <item name="colorOnSecondaryContainer">#1E3A8A</item>
        <!-- Tertiary -->
        <item name="colorTertiary">#6D28D9</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#EDE9FE</item>
        <item name="colorOnTertiaryContainer">#2E1065</item>
        <!-- Background + Surface -->
        <item name="android:colorBackground">#F8FAFC</item>
        <item name="colorOnBackground">#0F172A</item>
        <item name="colorSurface">#F8FAFC</item>
        <item name="colorSurfaceBright">#FFFFFF</item>
        <item name="colorSurfaceDim">#D0DCEF</item>
        <item name="colorSurfaceVariant">#E2E8F0</item>
        <item name="colorOnSurfaceVariant">#475569</item>
        <item name="colorSurfaceContainer">#EDF3FC</item>
        <item name="colorSurfaceContainerLow">#F3F7FD</item>
        <item name="colorSurfaceContainerHigh">#E6EEF9</item>
        <item name="colorSurfaceContainerHighest">#DCE6F4</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorOnSurface">#0F172A</item>
        <!-- Outline -->
        <item name="colorOutline">#94A3B8</item>
        <item name="colorOutlineVariant">#E2E8F0</item>
    </style>

