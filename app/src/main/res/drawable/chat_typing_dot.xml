<?xml version="1.0" encoding="utf-8"?>
<!--
    chat_typing_dot.xml
    ====================
    Small circular dot for the typing indicator animation.
    Three of these are used inside the typing indicator container.
    (A programmatic alpha-pulse animator class for these dots was written but never wired
    up anywhere, and was removed as dead code in the audit session — if the pulse animation
    is ever wanted, animate these views where the typing indicator is shown/hidden.)
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <solid android:color="@color/chat_typing_dot_color" />

    <size
        android:width="8dp"
        android:height="8dp" />

</shape>
