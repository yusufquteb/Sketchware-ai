    <!-- Required alongside foregroundServiceType="dataSync" on LocalModelDownloadService from
         API 34 (Android 14) onward — declaring the base FOREGROUND_SERVICE permission alone is
         no longer sufficient for a typed foreground service on those versions. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
