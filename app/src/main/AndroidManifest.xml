        <!--
          Firebase Messaging's SDK auto-requests POST_NOTIFICATIONS as soon as any
          Activity starts, before the app gets a chance to show its own permissions
          screen. Auto-init is disabled here so notification setup only happens
          after the user grants it explicitly from the Permissions screen; see
          SketchApplication (Firebase Messaging is initialized manually there once
          onboarding completes, or immediately on subsequent launches).
        -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <service
            android:name="pro.sketchware.firebase.FirebaseMessagingServiceImpl"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service android:name="pro.sketchware.ai.engine.AiBackgroundService" android:exported="false" />
        <!-- Runs LocalModelCatalog .litertlm downloads as a real foreground service so a
             transfer survives the user leaving AiSettingsActivity, switching apps, or locking
             the screen — see LocalModelDownloadService's class javadoc. foregroundServiceType is
             declared even though targetSdk (28) doesn't yet require it, so this doesn't need
             revisiting if targetSdk is raised later; dataSync matches Android's own guidance for
             file-download-style foreground services. -->
        <service
            android:name="pro.sketchware.ai.offline.LocalModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
